# Environment Mode: development | production | test
ENVIRONMENT=development

# Database Settings (PostgreSQL Multi-Tenant RLS Architecture)
POSTGRES_DB=ks_foodops
POSTGRES_OWNER_USER=ks_owner
POSTGRES_OWNER_PASSWORD=change_this_owner_password_in_production
POSTGRES_APP_USER=ksfoodops_app
POSTGRES_APP_PASSWORD=change_this_app_password_in_production

# Redis Settings
REDIS_PASSWORD=change_this_redis_password_in_production
REDIS_URL=redis://:change_this_redis_password_in_production@localhost:6379/0

# Security & Authentication (JWT Secret must be at least 32 bytes for HMAC-SHA256)
JWT_SECRET=replace_with_a_secure_minimum_32_bytes_random_secret_string_here_123456
JWT_ALGORITHM=HS256

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
